# Local Docker database credentials. Keep POSTGRES_* aligned: PostgreSQL only
# creates this user and password the first time its named volume is initialized.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_password_change_me_123456
POSTGRES_DB=social

NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# Used when the API runs on your machine. Docker derives its own DATABASE_URL.
DATABASE_URL=postgresql://postgres:local_dev_password_change_me_123456@localhost:5432/social?schema=public

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=local_redis_password_change_me_123456
REDIS_URL=redis://:local_redis_password_change_me_123456@localhost:6380
REDIS_TLS=false

JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_value
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Optional integrations
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ENDPOINT=
CLOUDFRONT_DOMAIN=
